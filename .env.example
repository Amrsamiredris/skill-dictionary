# Supabase (required for analytics + profiles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (required for global stats, admin, API writes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard (email + password sign-in at /admin/login)
ADMIN_EMAIL=amrsamiredris@gmail.com
ADMIN_PASSWORD=your-secure-password

# Vercel Analytics API (optional — powers Traffic tab in admin)
VERCEL_ACCESS_TOKEN=your-vercel-token
VERCEL_TEAM_ID=team_xxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxx
